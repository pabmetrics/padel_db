---
// Landing provisional: solo esta página se publica. El resto de secciones
// están en src/pendientes/ y se activan moviéndolas a src/pages/.
import Base from '../layouts/Base.astro';
import Figura from '../components/Figura.astro';

const series = [
  ['#RankingLunes', 'Ranking: quién sube, quién baja', 'Movimientos del top 100 y forma de las últimas semanas.'],
  ['El torneo en datos', 'Sorpresas y ganancias', 'Qué cabezas de serie caen y cuánto ha ganado cada jugador.'],
  ['#ParejasEnDatos', 'Parejas y cara a cara', 'Cuánto duran las parejas y quién gana los cruces repetidos.'],
  ['Perfil del top 100', 'Quién es el top 100', 'Edad, nacionalidad, altura y lado de pista.'],
  ['#MapaDelPádel', 'Pistas por provincia', 'Dónde hay más pádel por habitante en España.'],
  ['Pádel Mercado', 'Licencias, pistas y jugadores', 'El tamaño del pádel en España y en el mundo.'],
];
---
<Base minimo titulo="PadelDB" descripcion="La base de datos abierta del pádel, y un gráfico al día que sale de ella. Ranking, torneos, parejas, pistas y mercado, con las fuentes a la vista.">
  <div class="pagina-titulo">
    <div class="pildora">El pádel, en datos</div>
    <h1>Cada día, un dato del pádel que no vas a ver en ningún otro sitio.</h1>
    <p class="subtitulo">Y la base de datos para comprobarlo. PadelDB reúne resultados, rankings, pistas y mercado del pádel, los ordena y los publica con su fuente.</p>
  </div>

  <h2>Un vistazo</h2>
  <div class="graficos">
    <Figura enlace={false} archivo="perfil_top100_m_16x9.png" alt="Nacionalidades del top 100 masculino" />
    <Figura enlace={false} archivo="ganancias_temporada_m_16x9.png" alt="Ranking de ganancias de la temporada, masculino" />
    <Figura enlace={false} archivo="pistas_provincia_16x9.png" alt="Provincias con más pistas de pádel por 10.000 habitantes" />
    <Figura enlace={false} archivo="licencias_nacional_16x9.png" alt="Licencias federativas de pádel en España" />
  </div>

  <h2>Lo que viene</h2>
  <p>Estamos construyendo la web por secciones. Estas son las series en las que trabajamos:</p>
  <div class="rejilla">
    {series.map(([pildora, titulo, texto]) => (
      <div class="tarjeta">
        <div class="pildora">{pildora}</div>
        <h3>{titulo}</h3>
        <p>{texto}</p>
        <div class="meta">próximamente</div>
      </div>
    ))}
  </div>
</Base>
